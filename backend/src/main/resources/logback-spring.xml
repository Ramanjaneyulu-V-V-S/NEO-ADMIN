<?xml version="1.0" encoding="UTF-8"?>
<!--
  Adds a dedicated audit trail on top of Spring Boot's stock logging.

  The <include> pulls in Boot's default console + rolling-file setup unchanged,
  so everything driven by the logging.* keys in application-<profile>.properties
  (the rajbhasha.log root log) keeps working exactly as before.

  The AUDIT logger is separate (additivity="false"): it writes only to app.log
  and the console. app.log lands in $CATALINA_BASE/logs next to catalina.out on
  a deployed Tomcat; under `mvn spring-boot:run` it falls back to ./logs/app.log.
  Set NEOADMIN_AUDIT_DIR to override.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <property name="AUDIT_DIR" value="${NEOADMIN_AUDIT_DIR:-${catalina.base:-.}/logs}"/>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${AUDIT_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${AUDIT_DIR}/app.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
</configuration>
