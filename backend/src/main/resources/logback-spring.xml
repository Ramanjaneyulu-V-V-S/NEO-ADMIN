<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Use Tomcat's catalina.base if available, otherwise default to current directory -->
    <property name="LOG_PATH" value="${catalina.base:-.}/logs"/>
    
    <!-- Standard Console Appender for local development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
        </encoder>
    </appender>

    <!-- Synchronous File Appender -->
    <appender name="APP_FILE_SYNC" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- keep 30 days' worth of history -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Asynchronous File Appender to ensure application performance is not affected -->
    <appender name="APP_FILE_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="APP_FILE_SYNC" />
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <!-- Dedicated logger for user actions -->
    <logger name="APP_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="APP_FILE_ASYNC" />
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Root logger for everything else -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
